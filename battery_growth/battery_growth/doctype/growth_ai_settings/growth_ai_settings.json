{
  "actions": [],
  "doctype": "DocType",
  "document_type": "Setup",
  "engine": "InnoDB",
  "field_order": [
    "enabled",
    "provider",
    "base_url",
    "model",
    "api_key",
    "timeout_seconds",
    "cache_minutes"
  ],
  "fields": [
    {
      "default": "1",
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "启用 AI 运营简报"
    },
    {
      "default": "本地规则",
      "fieldname": "provider",
      "fieldtype": "Select",
      "label": "Provider",
      "options": "本地规则\nOpenAI Compatible",
      "reqd": 1
    },
    {
      "depends_on": "eval:doc.provider=='OpenAI Compatible'",
      "fieldname": "base_url",
      "fieldtype": "Data",
      "label": "Base URL"
    },
    {
      "depends_on": "eval:doc.provider=='OpenAI Compatible'",
      "fieldname": "model",
      "fieldtype": "Data",
      "label": "模型名"
    },
    {
      "depends_on": "eval:doc.provider=='OpenAI Compatible'",
      "fieldname": "api_key",
      "fieldtype": "Password",
      "label": "API Key"
    },
    {
      "default": "15",
      "fieldname": "timeout_seconds",
      "fieldtype": "Int",
      "label": "超时秒数",
      "reqd": 1
    },
    {
      "default": "15",
      "fieldname": "cache_minutes",
      "fieldtype": "Int",
      "label": "缓存分钟数",
      "reqd": 1
    }
  ],
  "issingle": 1,
  "module": "Battery Growth",
  "name": "Growth AI Settings",
  "permissions": [{ "read": 1, "role": "System Manager", "write": 1 }]
}
