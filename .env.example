# Battery Growth local demo defaults. Copy to .env and change passwords for any
# environment that is not an isolated local evaluation machine.
COMPOSE_PROJECT_NAME=battery-growth
FRAPPE_VERSION=v15.120.0
FRAPPE_DOCKER_REVISION=380b9d069ab949754fe78331af647b673984dc04
CUSTOM_IMAGE=battery-growth
CUSTOM_TAG=v15.120.0
PULL_POLICY=never
RESTART_POLICY=unless-stopped
SITE_NAME=battery.localhost
HTTP_PUBLISH_PORT=8080
FRAPPE_SITE_NAME_HEADER=battery.localhost
ADMIN_PASSWORD=admin
DB_PASSWORD=battery-local-db-change-me
